# Copy this file to ".env" (cp .env.example .env) and fill in the values.
# ".env" is private and gitignored; this example file is safe to commit.
# Full explanation of each variable: docs/configuration.md

# Port the server listens on (server.js falls back to 3000 if missing).
PORT=3000
NODE_ENV=development

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# REQUIRED. Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# REQUIRED. Stripe secret key; use a test key (sk_test_...) while developing.
STRIPE_SECRET_KEY=

# AWS settings (only needed once you use AWS services).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
